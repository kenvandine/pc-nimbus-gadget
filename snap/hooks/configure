#!/bin/sh

set -eu

# Install a oneshot systemd unit that clears the chromium kiosk's stale
# SingletonLock before chromium and ubuntu-frame start on every boot.
#
# Chromium refuses to start if its profile directory's SingletonLock file
# already exists (its normal single-instance guard) — but on an unclean
# shutdown that lock is never cleaned up, so the kiosk browser fails to
# launch on the next boot until someone removes it by hand. This hook runs
# on gadget install and on every gadget refresh, so it applies both to a
# freshly-provisioned image and to devices upgraded via an OTA gadget update.
#
# snapcraft's own app-level before/after ordering only orders services
# within the same snap, so a hand-written unit referencing the other snaps'
# generated service names directly is what's needed for cross-snap ordering
# (both those units and this one are WantedBy=multi-user.target, which is
# what puts them in the same boot transaction for the ordering to apply).
UNIT_PATH=/etc/systemd/system/nimbus-chromium-lock-fixup.service

cat > "$UNIT_PATH" <<'EOF'
[Unit]
Description=Remove stale chromium SingletonLock before the kiosk browser starts
DefaultDependencies=no
Before=snap.chromium.daemon.service snap.ubuntu-frame.daemon.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'rm -f /root/snap/chromium/common/chromium/SingletonLock'

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now nimbus-chromium-lock-fixup.service
